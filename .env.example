# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# --- Cloudinary (clip video upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase (Firestore highlight metadata) ---
# Path to the service account JSON key downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIRESTORE_COLLECTION=kross_highlight

# --- Retention ---
# Highlight clips older than this many days get their Cloudinary asset and
# Firestore doc deleted automatically.
CLIP_RETENTION_DAYS=7
