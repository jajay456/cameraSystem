# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# --- Cloudflare R2 (clip video upload) ---
# Dashboard > R2 > Manage API tokens > Create token (Object Read & Write,
# limited to the bucket below). If R2_ACCESS_KEY_ID is set, R2 is used for
# uploads instead of Cloudinary.
R2_ACCOUNT_ID=fc00b57b0777f211cfc47c09578218fe
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kross-clips
# Public URL clips are served from (r2.dev for testing; custom domain for production)
R2_PUBLIC_URL=https://pub-ff6d5cb659a2400f820b92c26560275e.r2.dev

# --- Cloudinary (old upload target; still used to delete clips uploaded before the switch) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase (Firestore highlight metadata) ---
# Path to the service account JSON key downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIRESTORE_COLLECTION=kross_highlight

# --- Retention ---
# Highlight clips older than this many days get their R2 object / Cloudinary asset and
# Firestore doc deleted automatically.
CLIP_RETENTION_DAYS=7
