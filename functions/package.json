{
  "name": "kross-highlight-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "dev:emulator": "npm run build && node scripts/start-emulator.js",
    "dev:live-read": "npm run build && node scripts/start-live-read.js",
    "seed": "node scripts/seed.js",
    "backfill": "node scripts/backfill.js",
    "api-gateway": "python3 scripts/api-gateway.py",
    "tunnel:quick": "bash scripts/tunnel-quick.sh",
    "tunnel:named": "bash scripts/tunnel-named.sh"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
